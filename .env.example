# Copy this file to .env and fill in the values. Never commit .env.

# PayPal SANDBOX credentials only. The app refuses any non-sandbox PayPal URL.
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Google Gemini API key (free at aistudio.google.com > Get API key). The model must accept images.
# Without a key the app still runs: rules come from a template and you pick the verdict by hand.
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# Verdicts below this confidence go to manual review instead of moving money.
CONFIDENCE_THRESHOLD=0.8

# Where the SQLite database and uploaded proof photos are kept. Defaults to ./data
DATA_DIR=

# Only for `npm run seed`: the demo account it creates.
SEED_EMAIL=demo@proofstake.test
SEED_PASSWORD=demo-password

# Password for the review queue at /review. If this is empty the review queue is switched off.
ADMIN_PASSWORD=
